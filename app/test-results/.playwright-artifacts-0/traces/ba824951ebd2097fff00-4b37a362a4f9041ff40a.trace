g: optimizeLegibility;\n  }\n  body {\n    margin: 0;\n    min-height: 100dvh;\n    overflow-x: clip;\n    -webkit-text-size-adjust: 100%;\n    font-family: var(--font-body);\n    font-size: 1.125rem;\n    line-height: 1.5;\n    color: var(--color-fg);\n    background: var(--noise), radial-gradient(120% 90% at 50% 0%, #2a2018 0%, #15110d 55%, #0b0908 100%);\n    background-attachment: fixed;\n  }\n  h1, h2, h3, h4 {\n    font-family: var(--font-heading);\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    line-height: 1.15;\n  }\n  ::selection {\n    background: var(--color-bronze-600);\n    color: var(--color-parchment-50);\n  }\n  :focus-visible {\n    outline: 3px solid var(--focus-ring);\n    outline-offset: 3px;\n  }\n  button, [role='button'], [role='tab'], [role='option'], [role='switch'], a {\n    -webkit-tap-highlight-color: transparent;\n  }\n  img {\n    user-select: none;\n    -webkit-user-drag: none;\n  }\n  * {\n    scrollbar-width: thin;\n    scrollbar-color: var(--color-bronze-700) transparent;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  html:not([data-reduced-motion]) *, html:not([data-reduced-motion]) *::before, html:not([data-reduced-motion]) *::after {\n    animation-duration: 1ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 1ms !important;\n    scroll-behavior: auto !important;\n  }\n}\nhtml[data-reduced-motion='true'] *, html[data-reduced-motion='true'] *::before, html[data-reduced-motion='true'] *::after {\n  animation-duration: 1ms !important;\n  animation-iteration-count: 1 !important;\n  transition-duration: 1ms !important;\n  scroll-behavior: auto !important;\n}\n@layer components {\n  .wk-frame {\n    position: relative;\n    border: 3px solid transparent;\n    border-radius: var(--radius-frame);\n    box-shadow: var(--shadow-panel);\n    background: var(--noise) padding-box, linear-gradient(180deg, var(--color-night-700), var(--color-night-800) 60%, var(--color-night-900)) padding-box, var(--frame-metal) border-box;\n    --frame-metal: linear-gradient(160deg, #8f949a 0%, #4a4e54 22%, #2b2d31 48%, #6a6f76 72%, #34373b 100%);\n  }\n  .wk-frame--bronze {\n    --frame-metal: linear-gradient(160deg, #ead2a8 0%, #a8773d 20%, #4f3417 50%, #c4955a 74%, #6e4a22 100%);\n  }\n  .wk-frame--oxblood {\n    --frame-metal: linear-gradient(160deg, #e08070 0%, #7f2420 25%, #2e0d0c 55%, #9b2f29 80%, #4a1513 100%);\n  }\n  .wk-frame--parchment {\n    --focus-ring: var(--color-oxblood-700);\n    color: var(--color-ink);\n    background: var(--parchment-texture) padding-box, radial-gradient(130% 120% at 50% 40%, transparent 55%, rgb(92 58 22 / 0.35) 100%) padding-box, var(--noise) padding-box, linear-gradient(175deg, #f3e7cb 0%, #e8d6ae 45%, #dcc395 100%) padding-box, var(--frame-metal) border-box;\n    background-size: auto, auto, 160px 160px, auto, auto;\n  }\n  .wk-frame--parchment.wk-frame--textured {\n    background-size: 512px 512px, auto, 160px 160px, auto, auto;\n  }\n  .wk-frame::after {\n    content: '';\n    position: absolute;\n    inset: 3px;\n    border-radius: calc(var(--radius-frame) - 3px);\n    border: 1px solid rgb(255 236 200 / 0.08);\n    pointer-events: none;\n  }\n  .wk-frame--parchment::after {\n    border-color: rgb(90 60 25 / 0.35);\n  }\n  .wk-rivets::before {\n    --rivet: radial-gradient(circle at 40% 35%, #f3e1b8 0 1px, #b08a52 1.6px, #5a3e1d 3px, rgb(0 0 0 / 0.55) 3.8px, transparent 4.4px);\n    content: '';\n    position: absolute;\n    inset: 4px;\n    pointer-events: none;\n    z-index: 1;\n    background: var(--rivet) top left / 10px 10px no-repeat, var(--rivet) top right / 10px 10px no-repeat, var(--rivet) bottom left / 10px 10px no-repeat, var(--rivet) bottom right / 10px 10px no-repeat;\n  }\n  .wk-plate {\n    --plate-top: #6a6f76;\n    --plate-mid: #3e4146;\n    --plate-bot: #26282b;\n    --plate-edge: #0d0d0e;\n    --plate-text: var(--color-parchment-100);\n    --plate-glint: rgb(255 255 255 / 0.22);\n    position: relative;\n    isolation: isolate;\n    color: var(--plate-text);\n    border: 2px solid var(--plate-edge);\n    border-radius: var(--radius-plate);\n    background: var(--noise), linear-gradient(180deg, var(--plate-top) 0%, var(--plate-mid) 48%, var(--plate-bot) 100%);\n    background-size: 160px 160px, auto;\n    box-shadow: inset 0 1px 0 var(--plate-glint), inset 0 -2px 0 rgb(0 0 0 / 0.35), 0 3px 0 #090706, 0 6px 12px -4px rgb(0 0 0 / 0.7);\n    transition: transform var(--duration-quick) var(--ease-weighty), box-shadow var(--duration-quick) var(--ease-weighty), filter var(--duration-base) ease;\n  }\n  .wk-plate:hover:not(:disabled, [aria-disabled='true']) {\n    filter: brightness(1.12) saturate(1.05);\n  }\n  .wk-plate:active:not(:disabled, [aria-disabled='true']) {\n    transform: translateY(2px);\n    box-shadow: inset 0 1px 0 var(--plate-glint), inset 0 2px 6px rgb(0 0 0 / 0.45), 0 1px 0 #090706;\n  }\n  .wk-plate:disabled, .wk-plate[aria-disabled='true'] {\n    cursor: not-allowed;\n    filter: grayscale(0.85) brightness(0.7);\n  }\n  .wk-plate--bronze {\n    --plate-top: #e3c48f;\n    --plate-mid: #b2823f;\n    --plate-bot: #7a5323;\n    --plate-edge: #2c1c0b;\n    --plate-text: #1d1209;\n    --plate-glint: rgb(255 245 220 / 0.6);\n  }\n  .wk-plate--oxblood {\n    --plate-top: #b64a3e;\n    --plate-mid: #7f2420;\n    --plate-bot: #4a1513;\n    --plate-edge: #1a0505;\n    --plate-text: #fbeede;\n    --plate-glint: rgb(255 200 180 / 0.35);\n  }\n  .wk-well {\n    background: var(--noise), linear-gradient(180deg, #0e0b09, #1a1511);\n    background-size: 160px 160px, auto;\n    border: 2px solid #3a2f22;\n    border-radius: var(--radius-plate);\n    box-shadow: var(--shadow-inset-deep), 0 1px 0 rgb(255 230 190 / 0.08);\n  }\n  .wk-frame--parchment .wk-well {\n    background: linear-gradient(180deg, #f6ecd4, #efe0bd);\n    border-color: #9a7b4e;\n    box-shadow: inset 0 2px 4px rgb(80 50 20 / 0.25);\n    color: var(--color-ink);\n  }\n  .wk-range {\n    --groove: linear-