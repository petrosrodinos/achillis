// White Knight — Prisma schema.
// DB columns are snake_case; the API maps them to camelCase JSON.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum MissionStatus {
  locked
  unlocked
  in_progress
  completed
}

enum Difficulty {
  squire
  knight
  champion
}

enum MissionRank {
  S
  A
  B
  C
  D
}

enum GameRunStatus {
  started
  completed
  defeated
  rejected
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique // stored lowercased
  username            String // display casing
  username_normalized String    @unique // lowercased, for case-insensitive uniqueness/login
  password            String
  role                AuthRole  @default(USER)
  email_verified_at   DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  profile                   Profile?
  settings                  Settings?
  mission_progress          MissionProgress[]
  score_entries             ScoreEntry[]
  unlocked_characters       UnlockedCharacter[]
  game_runs                 GameRun[]
  refresh_tokens            RefreshToken[]
  email_verification_tokens EmailVerificationToken[]
  password_reset_tokens     PasswordResetToken[]

  @@map("users")
}

model Profile {
  user_id                     String    @id
  level                       Int       @default(1)
  xp                          Int       @default(0)
  total_points                Int       @default(0) // sum of best score per mission
  title                       String    @default("Squire")
  current_mission_id          String    @default("m01")
  highest_unlocked_mission_id String    @default("m01")
  save_version                Int       @default(1)
  emperor_knight_unlocked_at  DateTime? // P4-08: tracked separately from story progress
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([total_points])
  @@map("profiles")
}

model Settings {
  user_id        String     @id
  master_volume  Float      @default(0.8)
  music_volume   Float      @default(0.6)
  sfx_volume     Float      @default(0.8)
  reduced_motion Boolean    @default(false)
  screen_shake   Boolean    @default(true)
  show_fps       Boolean    @default(false)
  difficulty     Difficulty @default(knight)
  key_bindings   Json
  updated_at     DateTime   @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("settings")
}

model MissionProgress {
  id                 String        @id @default(uuid())
  user_id            String
  mission_id         String
  status             MissionStatus @default(unlocked)
  best_score         Int           @default(0)
  best_time_ms       Int?
  best_rank          MissionRank?
  completions        Int           @default(0)
  first_completed_at DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, mission_id])
  @@index([mission_id, best_score])
  @@index([mission_id, best_time_ms])
  @@map("mission_progress")
}

model ScoreEntry {
  id          String      @id @default(uuid())
  user_id     String
  mission_id  String
  run_id      String      @unique
  score       Int
  duration_ms Int
  rank        MissionRank
  difficulty  Difficulty
  created_at  DateTime    @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([mission_id, created_at])
  @@index([user_id, mission_id])
  @@map("score_entries")
}

model UnlockedCharacter {
  id           String   @id @default(uuid())
  user_id      String
  character_id String
  source       String // 'registration' | 'mission' | 'score_threshold'
  unlocked_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, character_id])
  @@map("unlocked_characters")
}

model GameRun {
  id           String        @id @default(uuid())
  user_id      String
  mission_id   String
  status       GameRunStatus @default(started)
  started_at   DateTime      @default(now())
  completed_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@map("game_runs")
}

model RefreshToken {
  id          String    @id @default(uuid())
  user_id     String
  token_hash  String    @unique
  family_id   String
  expires_at  DateTime
  revoked_at  DateTime?
  replaced_by String?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([family_id])
  @@index([user_id])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}
